{
  "name": "rack-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:storefront": "tsc --noEmit && vite build --mode storefront",
    "preview": "vite preview",
    "dev:worker": "npx wrangler@4 dev --local --ip 127.0.0.1 --infer-origin-from-routes=false",
    "db:local": "npx wrangler@4 d1 migrations apply DB --local"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "vite": "^6.4.0"
  }
}
