{
  "name": "toteworks-atx",
  "main": "server/worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "routes": [
    { "pattern": "totesandtimber.com", "custom_domain": true },
    { "pattern": "www.totesandtimber.com", "custom_domain": true },
    { "pattern": "toteworksatx.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/rack-builds", "/rack-builds/", "/rack-builds/index.html", "/api/*", "/admin", "/admin/", "/quote/*", "/pay/*", "/order-received", "/order-received/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toteworks-atx",
      "database_id": "0b1f8055-ce33-483c-a3af-5bb300da4b5e"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
